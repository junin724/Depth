entity:SetCallback("OnDamagePlayer", function(newHealth)
    if newHealth <= 0 then
        if ReSt:FindFirstChild("GameStats") then
            local stats = ReSt.GameStats:FindFirstChild("Player_" .. Plr.Name)
            if stats then
                stats.Total.DeathCause.Value = "Ripper"
            end
        end
        
        if workspace:FindFirstChild("rippermoving") then
            workspace.rippermoving:Stop()
        end
        
        if workspace:FindFirstChild("Ripper") then
            workspace.Ripper:Destroy()
        end

        local character = Plr.Character
        if character and character:FindFirstChild("Humanoid") then
            character.Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
            character.Humanoid:SetStateEnabled(Enum.HumanoidStateType.Physics, false)
            character.HumanoidRootPart.Anchored = true
        end

        CustomGitSound("https://github.com/Kotyara19k-Doorsspawner/Random-files/raw/main/Y2meta.app%20-%20Doors%20HardCore%20Mode_%201%20ripper%20part%20sound%20(320%20kbps).mp3", 1, "Ripper5Sound")
        task.wait(1.5)
        
        CustomGitSound("https://github.com/Kotyara19k-Doorsspawner/Random-files/raw/main/Y2meta.app%20-%20Doors%20Hardcore%20Mode_%20Ripperscare%20part%202%20sound%20(320%20kbps).mp3", 1, "Ripper6Sound")
        
        local mainUI = Plr.PlayerGui:FindFirstChild("MainUI")
        if mainUI and mainUI:FindFirstChild("Drip") then
            local drip = mainUI.Drip
            drip.Image = "rbxassetid://236542974"
            
            drip.Visible = true
            task.wait(0.3)
            drip.Visible = false
            task.wait(0.1)
            drip.Visible = true
            task.wait(0.2)
            drip.Visible = true
            task.wait(0.2)
            drip.Visible = false
            task.wait(0.3)
            drip.Visible = true
            task.wait(0.2)
            drip.Visible = false
            task.wait(0.20)
        end

        if character and character:FindFirstChild("Humanoid") then
            character.Humanoid.Health = character.Humanoid.Health - 100
        end

        if ReSt:FindFirstChild("GameStats") and ReSt.GameStats:FindFirstChild("Player_" .. Plr.Name) then
            ReSt.GameStats["Player_" .. Plr.Name].Total.DeathCause.Value = "Ripper"
        end

        local func, setupval, getinfo, typeof, getgc, next = nil, debug.setupvalue or setupvalue, debug.getinfo or getinfo, typeof, getgc, next

        for i, v in next, getgc(false) do
            if typeof(v) == "function" then
                local info = getinfo(v)
                if info.currentline == 54 and info.nups == 2 and info.is_vararg == 0 then
                    func = v
                    break
                end
            end
        end

        if func then
            local function DeathHint(hints, typeStr: string)
                setupval(func, 1, hints)
                if typeStr ~= nil then
                    setupval(func, 2, typeStr)
                end
            end
        end
    end
end)

