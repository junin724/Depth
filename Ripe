entity:SetCallback("OnDamagePlayer", function(newHealth)
    if entity.HasCaughtPlayer then return end
    entity.HasCaughtPlayer = true

    if ReSt:FindFirstChild("GameStats") then
        local stats = ReSt.GameStats:FindFirstChild("Player_"..Plr.Name)
        if stats then
            stats.Total.DeathCause.Value = "Ripper"
        end
    end

    local character = Plr.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")

    if character then
        local humanoid = character:FindFirstChild("Humanoid")
        if humanoid then
            humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
            humanoid:SetStateEnabled(Enum.HumanoidStateType.Physics, false)
        end
        if root then
            root.Anchored = true
        end
    end

    local entityCFrame = CFrame.new(0, 0, 0)
    for _, obj in ipairs(Workspace:GetChildren()) do
        if obj.Name == "Ripper" then
            if obj:IsA("Model") and obj.PrimaryPart then
                entityCFrame = obj.PrimaryPart.CFrame
            elseif obj:IsA("Model") and obj:FindFirstChildWhichIsA("BasePart") then
                entityCFrame = obj:FindFirstChildWhichIsA("BasePart").CFrame
            end
            obj:Destroy()
        end
    end

    local newModel = SpawnNewModel("rbxassetid://12788499750", entityCFrame)

    local camera = Workspace.CurrentCamera
    camera.CameraType = Enum.CameraType.Scriptable

    local connection
    if newModel then
        local targetPart = newModel:IsA("Model") and (newModel.PrimaryPart or newModel:FindFirstChildWhichIsA("BasePart")) or newModel
        if targetPart then
            connection = RunService.RenderStepped:Connect(function()
                camera.CFrame = CFrame.new(camera.CFrame.Position, targetPart.Position)
            end)
        end
    end

    CustomGitSound("https://github.com/Kotyara19k-Doorsspawner/Random-files/raw/main/Y2meta.app%20-%20Doors%20HardCore%20Mode_%201%20ripper%20part%20sound%20(320%20kbps).mp3", 1, "Ripper5Sound", "RipperSound1")
    
    local dripUi = Plr:FindFirstChild("PlayerGui") and Plr.PlayerGui:FindFirstChild("MainUI") and Plr.PlayerGui.MainUI:FindFirstChild("Drip")
    if dripUi then
        dripUi.Image = "rbxassetid://236542974"
        dripUi.Visible = true
        task.wait(0.3)
        dripUi.Visible = false
        task.wait(0.1)
        dripUi.Visible = true
        task.wait(0.2)
        dripUi.Visible = true
        task.wait(0.2)
        dripUi.Visible = false
        task.wait(0.3)
        dripUi.Visible = true
        task.wait(0.2)
        dripUi.Visible = false
    end

    CustomGitSound("https://github.com/Kotyara19k-Doorsspawner/Random-files/raw/main/Y2meta.app%20-%20Doors%20Hardcore%20Mode_%20Ripperscare%20part%202%20sound%20(320%20kbps).mp3", 1, "Ripper6Sound", "RipperSound2")

    task.wait(3)

    if connection then
        connection:Disconnect()
    end
    camera.CameraType = Enum.CameraType.Custom

    if newModel then
        newModel:Destroy()
    end

    if character and character:FindFirstChild("Humanoid") then
        character.Humanoid.Health = 0
    end

    if ReSt:FindFirstChild("GameStats") and ReSt.GameStats:FindFirstChild("Player_"..Plr.Name) then
        ReSt.GameStats["Player_"..Plr.Name].Total.DeathCause.Value = "Ripper"
    end
end)

---====== Checagem de Chegada na Porta usando o sistema do Doors ======---
task.spawn(function()
    local trackedRooms = {}
    while entity do
        task.wait(0.2)
        local latestRoom = ReSt:FindFirstChild("LatestRoom") and ReSt.LatestRoom.Value or (Workspace:FindFirstChild("LatestRoom") and Workspace.LatestRoom.Value)
        if latestRoom and not trackedRooms[latestRoom] then
            trackedRooms[latestRoom] = true
            
            -- Aguarda a entidade chegar na sala atual
            task.spawn(function()
                while entity and entity.NodeList do
                    task.wait(0.5)
                    -- Se o monstro estiver na sala correspondente
                    if entity.CurrentRoom == latestRoom then
                        local roomObj = Workspace:FindFirstChild("Rooms") and Workspace.Rooms:FindFirstChild(tostring(latestRoom))
                        if roomObj then
                            local door = roomObj:FindFirstChild("Door") or roomObj:FindFirstChild("Gate")
                            if door and door:FindFirstChild("ClientOpen") or door then -- Garante encontrar a porta
                                local waitModel = SpawnNewModel("rbxassetid://77256500036807", door.CFrame)
                                task.wait(3)
                                if waitModel then
                                    waitModel:Destroy()
                                end
                                break
                            end
                        end
                    end
                end
            end)
        end
    end
end)

