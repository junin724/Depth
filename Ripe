---====== Utility Functions ======---

local function GitAud(soundgit, filename)
    local url = soundgit
    local FileName = filename
    writefile(FileName..".mp3", game:HttpGet(url))
    return (getcustomasset or getsynasset)(FileName..".mp3")
end

local function CustomGitSound(soundlink, vol, filename, soundName)
    local sound = Instance.new("Sound")
    sound.SoundId = GitAud(soundlink, filename)
    sound.Parent = Workspace
    sound.Name = soundName or "CustomSound"
    sound.Volume = vol
    sound.PlaybackSpeed = 1
    sound:Play()
    return sound
end

local function SpawnNewModel(assetId, cframePos)
    local success, model = pcall(function()
        return game:GetObjects(assetId)[1]
    end)
    if success and model then
        model.Parent = Workspace
        model:PivotTo(cframePos)
        return model
    end
    return nil
end

